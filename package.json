{
  "name": "gitmono-agent-team",
  "version": "0.1.0",
  "private": true,
  "description": "Three-agent, evidence-first collaboration contracts for Libra-backed repositories.",
  "type": "module",
  "scripts": {
    "demo": "node src/demo.js",
    "demo:check": "node scripts/verify-demo.js",
    "test": "node scripts/run-tests.js",
    "test:contracts": "node --test test/contracts.test.js",
    "test:coverage": "node scripts/run-tests.js --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=80 --test-coverage-branches=65"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "ajv-formats": "3.0.1"
  }
}
