# Local development/demo only. Change every credential before using a shared
# environment, and keep Mega/ScorpioFS bound to loopback unless protected by an
# authenticating reverse proxy.

COMPOSE_PROJECT_NAME=gitmono-agent-infra

# Mega uses the official multi-architecture image pinned by OCI digest.
MEGA_ENGINE_IMAGE=public.ecr.aws/m8q5m4u3/mega/mono-engine@sha256:43cc0e9ccc7ec8e21990f850597dd60e321435b185fe9f6d3f2bf58ad8ae4472
MEGA_MONOREPO__ADMIN=admin
MEGA_LOG_LEVEL=info
MEGA_BIND_ADDRESS=127.0.0.1
MEGA_HOST_PORT=8000

# Headless Mega infrastructure. One credential pair is used consistently by
# RustFS, bucket initialization, and Mega's S3-compatible client.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mono
# Keep this URL aligned with the three PostgreSQL values above. Percent-encode
# reserved characters in the username/password component (for example, @ as %40).
MEGA_DATABASE_URL=postgres://postgres:postgres@postgres:5432/mono
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
MEGA_S3_BUCKET=mega
MEGA_S3_REGION=us-east-1

# ScorpioFS is built from the pinned submodule by default.
SCORPIOFS_IMAGE=gitmono/scorpiofs:local
SCORPIO_BASE_URL=http://mega:8000
SCORPIO_LFS_URL=http://mega:8000/api/v1/lfs
SCORPIO_LOG=info
SCORPIO_FUSE_DEVICE=/dev/fuse
SCORPIO_BIND_ADDRESS=127.0.0.1
SCORPIO_HOST_PORT=2725
